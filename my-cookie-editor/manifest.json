{
  "manifest_version": 3,
  "name": "My Cookie Editor",
  "version": "1.0.0",
  "description": "View, search, add, edit, delete, export and import cookies for the current site.",
  "icons": { "16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "My Cookie Editor" },
  "permissions": ["cookies", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
